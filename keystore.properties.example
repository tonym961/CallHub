# Copy to keystore.properties (gitignored) and fill in your own values.
# Generate a keystore:
#   keytool -genkeypair -v -keystore callhub-release.keystore -alias callhub \
#     -keyalg RSA -keysize 2048 -validity 10000
# Keep the keystore + these passwords safe: losing them means you can no longer
# update a published app.
storeFile=/absolute/path/to/callhub-release.keystore
storePassword=CHANGE_ME
keyAlias=callhub
keyPassword=CHANGE_ME
